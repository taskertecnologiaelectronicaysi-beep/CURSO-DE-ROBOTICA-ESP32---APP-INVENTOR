#include <Arduino.h>
#include "BluetoothSerial.h"

#if !defined(CONFIG_BT_ENABLED) || !defined(CONFIG_BLUEDROID_ENABLED)
#error Bluetooth clasico no disponible: usa un ESP32 normal.
#endif

BluetoothSerial SerialBT;
#define NOMBRE_BT "RobotCar"

// =====================================
// TB6612FNG - CONTROLADOR U1
// =====================================
#define U1_PWMA 32
#define U1_AIN1 25
#define U1_AIN2 33
#define U1_STBY 26

#define U1_PWMB 12
#define U1_BIN1 27
#define U1_BIN2 14

// =====================================
// TB6612FNG - CONTROLADOR U2
// =====================================
#define U2_PWMA 0
#define U2_AIN1 16
#define U2_AIN2 4
#define U2_STBY 17

#define U2_PWMB 19
#define U2_BIN1 5
#define U2_BIN2 18

// =====================================
// SENSORES TCRT5000 - 5 CANALES
// =====================================
#define S1 15
#define S2 2
#define S3 21
#define S4 22
#define S5 23

const int sensores[5] = {S1, S2, S3, S4, S5};

// true = HIGH detecta la linea
// false = LOW detecta la linea
#define LINEA_BLANCA_HIGH true

// Posiciones de los sensores
const int pesos[5] = {-2, -1, 0, 1, 2};

// =====================================
// MODOS DE FUNCIONAMIENTO
// =====================================
enum Modo {
  MODO_MANUAL,
  MODO_AUTOMATICO,
  MODO_PID
};

Modo modoActual = MODO_MANUAL;

bool marchaHabilitada = false;

// =====================================
// CONFIGURACION PWM
// =====================================
#define PWM_FREQ 20000
#define PWM_RES 8

#define PWM_MIN 60

#define PASO_RAMPA 10
#define INTERVALO_RAMPA_MS 10

// Velocidad base: 0 a 255
int velocidad = 180;

// Direcciones manuales
int dirIzq = 0;
int dirDer = 0;

// Objetivos de los motores
int objIzq = 0;
int objDer = 0;

// Velocidades actuales
int actIzq = 0;
int actDer = 0;

unsigned long ultimaRampa = 0;

// Inversion de motores
bool invM1A = false;
bool invM1B = false;
bool invM2A = false;
bool invM2B = false;

// =====================================
// CONFIGURACION PID
// =====================================
// Ganancias (el error va de -2 a 2, asi que Kp debe ser alto:
// con Kp=75 y error=2 la correccion es 150 PWM)
float Kp = 75.0;
float Ki = 0.0;    // en seguidores de linea casi nunca hace falta
float Kd = 1.0;

// Filtro de la derivada (0 a 1): menor = mas suave, mas lento
float filtroDerivada = 0.3;
float derivadaFiltrada = 0;

// Reduccion de velocidad en curvas (0 a 1): con error maximo (2)
// la velocidad base baja este porcentaje. 0 = sin reduccion.
float reduccionCurva = 0.30;

float errorPID = 0;
float errorAnterior = 0;
float integralPID = 0;
float derivadaPID = 0;

float limiteIntegral = 10.0;
float limiteCorreccion = 220.0;

// Una rueda puede girar hacia atras hasta este PWM
// cuando la correccion es muy fuerte (curvas cerradas)
#define PWM_REVERSA_MAX 100

unsigned long ultimaLecturaControl = 0;

#define INTERVALO_CONTROL_MS 10

// =====================================
// CONFIGURACION DE ESQUINAS / CURVAS CERRADAS
// =====================================

// PWM del pivote (giro sobre su eje). Se calcula como el 70 % de la
// velocidad base, limitado a este rango. Si el robot se pasa de la
// curva, BAJA estos valores. Si no tiene fuerza para girar, sube MIN.
#define PWM_GIRO_MIN 90
#define PWM_GIRO_MAX 150

// Sensores minimos activos (con los dos del borde del lado de la
// curva encendidos) para considerar una esquina
#define ESQUINA_MIN_SENSORES 3

// *** PARAMETRO MAS IMPORTANTE ***
// Avance antes de pivotar. Debe ser el tiempo que tarda el robot en
// recorrer la distancia entre la barra de sensores y el EJE de las
// ruedas: asi el robot gira exactamente sobre la esquina.
//   tiempo (ms) = distancia (cm) / velocidad (cm/s) * 1000
// Si pivota y la linea queda "lejos", aumenta este valor.
// Si se pasa de la esquina antes de girar, disminuyelo.
#define AVANCE_ESQUINA_MS 60

// Giro minimo antes de aceptar que encontro la linea (evita falsos positivos)
#define GIRO_MIN_MS 40

// Tiempo maximo de un giro de esquina (antes eran 1200 ms = casi 180 grados)
#define GIRO_MAX_MS 700

// Tiempo maximo buscando la linea perdida antes de detenerse
#define PERDIDA_MAX_MS 800

enum EstadoSeguimiento {
  SEG_SEGUIR,
  SEG_ESQ_AVANZAR,
  SEG_ESQ_GIRAR,
  SEG_BUSCAR
};

EstadoSeguimiento estadoSeg = SEG_SEGUIR;

int ladoGiro = 0;        // -1 izquierda, 1 derecha
int ultimoLado = 0;      // ultimo lado donde estuvo la linea
unsigned long inicioEstado = 0;
unsigned long perdidaDesde = 0;

// =====================================
// ESCALA DE VELOCIDAD
// =====================================
int escalar(int v) {

  v = constrain(v, 0, 255);

  if (v == 0) return 0;

  return map(v, 1, 255, PWM_MIN, 255);
}

// Asegura el PWM minimo cuando un motor
// debe girar, sin modificar los valores cero.
int limitarPWM(int valor) {

  valor = constrain(valor, -255, 255);

  if (valor > 0 && valor < PWM_MIN)
    return PWM_MIN;

  if (valor < 0 && valor > -PWM_MIN)
    return -PWM_MIN;

  return valor;
}

// Zona muerta para el PID: un motor por debajo de PWM_MIN no gira,
// asi que ese rango se trata como 0. Antes limitarPWM() lo forzaba a
// +-60, y la rueda interna saltaba de +60 a -60 de golpe (movimiento
// brusco y descoordinado).
int zonaMuerta(int valor) {

  valor = constrain(valor, -255, 255);

  if (abs(valor) < PWM_MIN) return 0;

  return valor;
}

// =====================================
// CONTROL DE MOTORES
// =====================================
void controlarMotor(
  int pwm,
  int in1,
  int in2,
  int valor,
  bool invertir
) {

  if (invertir) valor = -valor;

  valor = constrain(valor, -255, 255);

  if (valor > 0) {

    digitalWrite(in1, HIGH);
    digitalWrite(in2, LOW);

  }
  else if (valor < 0) {

    digitalWrite(in1, LOW);
    digitalWrite(in2, HIGH);

  }
  else {

    digitalWrite(in1, LOW);
    digitalWrite(in2, LOW);
  }

  ledcWrite(pwm, abs(valor));
}

void aplicarMotores(int izquierda, int derecha) {

  controlarMotor(
    U1_PWMA, U1_AIN1, U1_AIN2,
    izquierda, invM1A
  );

  controlarMotor(
    U2_PWMA, U2_AIN1, U2_AIN2,
    izquierda, invM2A
  );

  controlarMotor(
    U1_PWMB, U1_BIN1, U1_BIN2,
    derecha, invM1B
  );

  controlarMotor(
    U2_PWMB, U2_BIN1, U2_BIN2,
    derecha, invM2B
  );
}

// =====================================
// OBJETIVOS DE LOS MOTORES
// =====================================
void establecerObjetivos(int izquierda, int derecha) {

  objIzq = limitarPWM(izquierda);
  objDer = limitarPWM(derecha);
}

void actualizarObjetivoManual() {

  int pwm = escalar(velocidad);

  if (!marchaHabilitada) {
    establecerObjetivos(0, 0);
    return;
  }

  establecerObjetivos(
    dirIzq * pwm,
    dirDer * pwm
  );
}

// =====================================
// RAMPA DE ACELERACION
// (solo se usa en modo manual)
// =====================================
int acercar(int actual, int objetivo) {

  // Impulso inicial
  if (actual == 0 && objetivo != 0) {

    int arranque = min(
      abs(objetivo),
      (int)PWM_MIN
    );

    return (objetivo > 0) ? arranque : -arranque;
  }

  // Si cambia el sentido, primero detener
  if ((actual > 0 && objetivo < 0) ||
      (actual < 0 && objetivo > 0)) {
    objetivo = 0;
  }

  if (actual < objetivo)
    return min(actual + PASO_RAMPA, objetivo);

  if (actual > objetivo)
    return max(actual - PASO_RAMPA, objetivo);

  return actual;
}

void actualizarRampa() {

  // En AUTOMATICO y PID la correccion debe aplicarse
  // al instante: la rampa retrasaba las curvas y
  // obligaba a frenar al invertir una rueda.
  if (modoActual != MODO_MANUAL) {

    if (objIzq != actIzq || objDer != actDer) {

      actIzq = objIzq;
      actDer = objDer;

      aplicarMotores(actIzq, actDer);
    }

    return;
  }

  if (millis() - ultimaRampa < INTERVALO_RAMPA_MS)
    return;

  ultimaRampa = millis();

  int nuevoIzq = acercar(actIzq, objIzq);
  int nuevoDer = acercar(actDer, objDer);

  if (nuevoIzq != actIzq || nuevoDer != actDer) {

    actIzq = nuevoIzq;
    actDer = nuevoDer;

    aplicarMotores(actIzq, actDer);
  }
}

// =====================================
// REINICIAR VARIABLES DE CONTROL
// =====================================
void reiniciarControl() {

  errorPID = 0;
  errorAnterior = 0;
  integralPID = 0;
  derivadaPID = 0;
  derivadaFiltrada = 0;

  estadoSeg = SEG_SEGUIR;
  ladoGiro = 0;
  ultimoLado = 0;

  ultimaLecturaControl = millis();
}

// =====================================
// DETENER MOTORES
// =====================================
void detener() {

  marchaHabilitada = false;

  dirIzq = 0;
  dirDer = 0;

  establecerObjetivos(0, 0);

  actIzq = 0;
  actDer = 0;

  aplicarMotores(0, 0);
}

// =====================================
// CAMBIAR VELOCIDAD
// =====================================
void cambiarVelocidad(int nueva) {

  velocidad = constrain(nueva, 0, 255);

  if (modoActual == MODO_MANUAL) {
    actualizarObjetivoManual();
  }

  Serial.print("VELOCIDAD BASE: ");
  Serial.println(velocidad);
}

// =====================================
// ACTIVAR MODO AUTOMATICO
// =====================================
void activarAutomatico() {

  detener();

  modoActual = MODO_AUTOMATICO;

  reiniciarControl();

  marchaHabilitada = true;

  Serial.println("MODO AUTOMATICO ACTIVADO");
}

// =====================================
// ACTIVAR MODO PID
// =====================================
void activarPID() {

  detener();

  modoActual = MODO_PID;

  reiniciarControl();

  marchaHabilitada = true;

  Serial.println("MODO PID ACTIVADO");
}

// =====================================
// CONTROL MANUAL
// =====================================
void mover(int izq, int der) {

  if (modoActual != MODO_MANUAL) {

    detener();

    modoActual = MODO_MANUAL;

    reiniciarControl();

    Serial.println("MODO MANUAL ACTIVADO");
  }

  dirIzq = izq;
  dirDer = der;

  marchaHabilitada = true;

  actualizarObjetivoManual();

  Serial.println("MOVIMIENTO MANUAL");
}

void avanzar() {
  mover(1, 1);
}

void retroceder() {
  mover(-1, -1);
}

void izquierda() {
  mover(-1, 1);
}

void derecha() {
  mover(1, -1);
}

// =====================================
// LECTURA DE LOS SENSORES
// =====================================
bool detectarLinea(int pin) {

  bool estado = digitalRead(pin);

  if (LINEA_BLANCA_HIGH) {
    return estado == HIGH;
  }
  else {
    return estado == LOW;
  }
}

// Lee los 5 sensores una sola vez por ciclo.
// Devuelve la cantidad de sensores sobre la linea.
int leerSensores(bool s[5]) {

  int cantidad = 0;

  for (int i = 0; i < 5; i++) {

    s[i] = detectarLinea(sensores[i]);

    if (s[i]) cantidad++;
  }

  return cantidad;
}

// =====================================
// CALCULAR POSICION DE LA LINEA
// =====================================
bool calcularPosicion(const bool s[5], int cantidad, float &posicion) {

  if (cantidad == 0) {
    posicion = 0;
    return false;
  }

  int suma = 0;

  for (int i = 0; i < 5; i++) {
    if (s[i]) suma += pesos[i];
  }

  posicion = (float)suma / cantidad;

  return true;
}

// =====================================
// GIRO SOBRE SU EJE
// lado: -1 = izquierda, 1 = derecha
// =====================================
void pivotar(int lado, int vel) {

  if (lado < 0) {
    establecerObjetivos(-vel, vel);
  }
  else {
    establecerObjetivos(vel, -vel);
  }
}

void cambiarEstadoSeg(EstadoSeguimiento nuevo) {

  estadoSeg = nuevo;
  inicioEstado = millis();

  switch (nuevo) {
    case SEG_SEGUIR:      Serial.println("SEG: SEGUIR LINEA"); break;
    case SEG_ESQ_AVANZAR: Serial.println("SEG: ESQUINA - AVANZAR"); break;
    case SEG_ESQ_GIRAR:   Serial.println("SEG: ESQUINA - GIRANDO"); break;
    case SEG_BUSCAR:      Serial.println("SEG: LINEA PERDIDA - BUSCANDO"); break;
  }
}

void reanudarSeguimiento(float posicion) {

  integralPID = 0;
  derivadaPID = 0;
  derivadaFiltrada = 0;
  errorAnterior = posicion;

  cambiarEstadoSeg(SEG_SEGUIR);
}

// =====================================
// GESTION DE ESQUINAS Y LINEA PERDIDA
//
// Devuelve true si esta funcion se encargo
// de los motores en este ciclo (esquina o
// busqueda). Devuelve false si se debe seguir
// la linea normalmente (reglas o PID).
//
// CAMBIOS RESPECTO A LA VERSION ANTERIOR:
//  - Antes el giro tenia 2 fases: "esperar a que el sensor central
//    SALGA de la linea" y luego "esperar a que ENTRE". Eso solo
//    funciona si el robot gira exactamente sobre la esquina; si no,
//    el sensor central nunca encuentra la linea y el robot giraba
//    hasta el tiempo maximo (casi 180 grados).
//  - Ahora hay una sola fase: pivotar hasta que la linea quede
//    CENTRADA (sensor central activo y sensores de los bordes
//    apagados). Esto termina al alinearse con la nueva linea, sea
//    de 30, 60 o 90 grados.
//  - La esquina solo se detecta con 2 sensores contiguos del borde
//    (S1+S2 o S5+S4), para que las curvas suaves las resuelva el PID.
//  - Velocidad de pivote y tiempos maximos reducidos.
// =====================================
bool gestionarGiros(const bool s[5], int n, float pos, int base) {

  unsigned long ahora = millis();

  int velGiro = constrain(base * 70 / 100, PWM_GIRO_MIN, PWM_GIRO_MAX);

  // Recordar de que lado estaba la linea
  if (n > 0) {

    if (s[0] && !s[4]) ultimoLado = -1;
    else if (s[4] && !s[0]) ultimoLado = 1;
    else if (pos <= -0.7) ultimoLado = -1;
    else if (pos >= 0.7) ultimoLado = 1;
  }

  switch (estadoSeg) {

    // ---------------------------------
    case SEG_SEGUIR: {

      // Linea perdida: buscar hacia el ultimo lado
      if (n == 0) {

        ladoGiro = (ultimoLado != 0) ? ultimoLado : 1;
        perdidaDesde = ahora;

        cambiarEstadoSeg(SEG_BUSCAR);
        pivotar(ladoGiro, velGiro);

        return true;
      }

      bool esquinaIzq = (n >= ESQUINA_MIN_SENSORES) && s[0] && s[1] && !s[4];
      bool esquinaDer = (n >= ESQUINA_MIN_SENSORES) && s[4] && s[3] && !s[0];

      if (esquinaIzq || esquinaDer) {

        ladoGiro = esquinaIzq ? -1 : 1;
        cambiarEstadoSeg(SEG_ESQ_AVANZAR);
        establecerObjetivos(base, base);

        return true;
      }

      return false;
    }

    // ---------------------------------
    // Avanzar hasta que el eje de las ruedas quede sobre la esquina
    case SEG_ESQ_AVANZAR:

      establecerObjetivos(base, base);

      if (ahora - inicioEstado >= AVANCE_ESQUINA_MS) {
        cambiarEstadoSeg(SEG_ESQ_GIRAR);
      }

      return true;

    // ---------------------------------
    // Pivotar hasta que la linea quede centrada
    case SEG_ESQ_GIRAR: {

      pivotar(ladoGiro, velGiro);

      bool centrada = s[2] && !s[0] && !s[4];

      if (centrada && (ahora - inicioEstado >= GIRO_MIN_MS)) {
        reanudarSeguimiento(pos);
        return false;
      }

      if (ahora - inicioEstado >= GIRO_MAX_MS) {
        perdidaDesde = ahora;
        cambiarEstadoSeg(SEG_BUSCAR);
      }

      return true;
    }

    // ---------------------------------
    case SEG_BUSCAR:

      if (n > 0) {
        reanudarSeguimiento(pos);
        return false;
      }

      if (ahora - perdidaDesde > PERDIDA_MAX_MS) {
        // No la encontro: detener (se reanuda sola
        // si la linea vuelve a aparecer)
        establecerObjetivos(0, 0);
        return true;
      }

      pivotar(ladoGiro, velGiro);

      return true;
  }

  return false;
}

// =====================================
// MODO AUTOMATICO BASICO
// SIN PID (por reglas)
// =====================================
void ejecutarAutomatico() {

  if (modoActual != MODO_AUTOMATICO) return;

  if (!marchaHabilitada) return;

  bool s[5];
  int n = leerSensores(s);

  float posicion = 0;
  bool encontrada = calcularPosicion(s, n, posicion);

  int base = escalar(velocidad);

  // Esquinas y linea perdida
  if (gestionarGiros(s, n, posicion, base)) return;

  if (!encontrada) return;

  int izquierda = base;
  int derecha = base;

  if (posicion <= -1.5) {

    // Giro fuerte izquierda: rueda interna hacia atras
    izquierda = -base * 35 / 100;
    derecha = base;
  }
  else if (posicion < -0.3) {

    // Giro suave izquierda
    izquierda = base * 55 / 100;
    derecha = base;
  }
  else if (posicion >= 1.5) {

    // Giro fuerte derecha: rueda interna hacia atras
    izquierda = base;
    derecha = -base * 35 / 100;
  }
  else if (posicion > 0.3) {

    // Giro suave derecha
    izquierda = base;
    derecha = base * 55 / 100;
  }

  establecerObjetivos(izquierda, derecha);
}

// =====================================
// MODO PID
// =====================================
void ejecutarPID() {

  if (modoActual != MODO_PID) return;

  if (!marchaHabilitada) return;

  unsigned long ahora = millis();

  if (ahora - ultimaLecturaControl < INTERVALO_CONTROL_MS)
    return;

  float dt = (ahora - ultimaLecturaControl) / 1000.0;

  ultimaLecturaControl = ahora;

  if (dt <= 0) return;

  bool s[5];
  int n = leerSensores(s);

  float posicion = 0;
  bool encontrada = calcularPosicion(s, n, posicion);

  int base = escalar(velocidad);

  // Esquinas y linea perdida
  if (gestionarGiros(s, n, posicion, base)) return;

  if (!encontrada) return;

  // Error respecto al centro
  errorPID = posicion;

  // Integral
  integralPID += errorPID * dt;

  integralPID = constrain(
    integralPID,
    -limiteIntegral,
    limiteIntegral
  );

  // Derivada filtrada (los sensores digitales dan saltos bruscos)
  float derivadaCruda = (errorPID - errorAnterior) / dt;

  derivadaFiltrada += filtroDerivada * (derivadaCruda - derivadaFiltrada);

  derivadaPID = derivadaFiltrada;

  // Salida PID
  float correccion =
      Kp * errorPID
    + Ki * integralPID
    + Kd * derivadaPID;

  correccion = constrain(
    correccion,
    -limiteCorreccion,
    limiteCorreccion
  );

  errorAnterior = errorPID;

  // Reducir la velocidad base segun lo desviado que este el robot
  int baseCurva = base - (int)(base * reduccionCurva * fabsf(errorPID) / 2.0);

  baseCurva = max(baseCurva, (int)PWM_MIN);

  // Correccion diferencial
  int izquierda = baseCurva + (int)correccion;
  int derecha = baseCurva - (int)correccion;

  // Permite que la rueda interna retroceda un poco
  // en curvas muy cerradas
  izquierda = constrain(izquierda, -PWM_REVERSA_MAX, 255);
  derecha = constrain(derecha, -PWM_REVERSA_MAX, 255);

  // Zona muerta (en vez de forzar +-PWM_MIN)
  izquierda = zonaMuerta(izquierda);
  derecha = zonaMuerta(derecha);

  objIzq = izquierda;
  objDer = derecha;

  // Informacion de prueba cada 200 ms
  static unsigned long ultimaImpresionPID = 0;

  if (millis() - ultimaImpresionPID >= 200) {

    ultimaImpresionPID = millis();

    Serial.print("PID ERROR: ");
    Serial.print(errorPID);

    Serial.print(" | CORRECCION: ");
    Serial.print(correccion);

    Serial.print(" | IZQ: ");
    Serial.print(izquierda);

    Serial.print(" | DER: ");
    Serial.println(derecha);
  }
}

// =====================================
// BLUETOOTH - RECEPCION DE BYTES
//
// 1 = AVANZAR
// 2 = RETROCEDER
// 3 = IZQUIERDA
// 4 = DERECHA
// 5 = STOP
// 8 = AUTOMATICO
// 9 = PID
// 10-100 = SLIDER PWM
// =====================================
void procesarByte(int b) {

  switch (b) {

    case 1:
      avanzar();
      break;

    case 2:
      retroceder();
      break;

    case 3:
      izquierda();
      break;

    case 4:
      derecha();
      break;

    case 5:
      detener();
      modoActual = MODO_MANUAL;
      reiniciarControl();
      Serial.println("STOP - MODO MANUAL");
      break;

    case 8:
      activarAutomatico();
      break;

    case 9:
      activarPID();
      break;

    default:

      if (b >= 10 && b <= 100) {

        cambiarVelocidad(
          map(b, 10, 100, 0, 255)
        );
      }

      break;
  }
}

// =====================================
// COMANDOS USB PARA PRUEBAS
// =====================================
void procesarComando(String comando) {

  comando.trim();
  comando.toUpperCase();

  if (comando.length() == 0) return;

  if (comando == "F") {
    avanzar();
  }
  else if (comando == "B") {
    retroceder();
  }
  else if (comando == "L") {
    izquierda();
  }
  else if (comando == "R") {
    derecha();
  }
  else if (comando == "S") {
    detener();
    modoActual = MODO_MANUAL;
    reiniciarControl();
  }
  else if (comando == "A") {
    activarAutomatico();
  }
  else if (comando == "P") {
    activarPID();
  }
  else if (comando == "+") {
    cambiarVelocidad(velocidad + 10);
  }
  else if (comando == "-") {
    cambiarVelocidad(velocidad - 10);
  }
  else if (comando.startsWith("V")) {
    cambiarVelocidad(comando.substring(1).toInt());
  }
  else if (comando == "?") {

    Serial.println("COMANDOS USB:");
    Serial.println("F = AVANZAR");
    Serial.println("B = RETROCEDER");
    Serial.println("L = IZQUIERDA");
    Serial.println("R = DERECHA");
    Serial.println("S = STOP");
    Serial.println("A = AUTOMATICO");
    Serial.println("P = PID");
    Serial.println("V0-V255 = VELOCIDAD");
    Serial.println("+ / - = AJUSTAR VELOCIDAD");
  }
  else {
    Serial.println("COMANDO NO RECONOCIDO");
  }
}

// =====================================
// CONFIGURACION INICIAL
// =====================================
void setup() {

  Serial.begin(115200);
  Serial.setTimeout(20);

  // Pines de motores
  int pines[] = {
    U1_AIN1, U1_AIN2,
    U1_BIN1, U1_BIN2,
    U2_AIN1, U2_AIN2,
    U2_BIN1, U2_BIN2,
    U1_STBY, U2_STBY
  };

  for (int i = 0; i < 10; i++) {

    pinMode(pines[i], OUTPUT);
    digitalWrite(pines[i], LOW);
  }

  // Sensores TCRT5000
  for (int i = 0; i < 5; i++) {
    pinMode(sensores[i], INPUT);
  }

  // PWM ESP32 Arduino Core 3.x
  ledcAttach(U1_PWMA, PWM_FREQ, PWM_RES);
  ledcAttach(U1_PWMB, PWM_FREQ, PWM_RES);

  ledcAttach(U2_PWMA, PWM_FREQ, PWM_RES);
  ledcAttach(U2_PWMB, PWM_FREQ, PWM_RES);

  // Habilitar controladores
  digitalWrite(U1_STBY, HIGH);
  digitalWrite(U2_STBY, HIGH);

  detener();

  // Bluetooth Classic
  SerialBT.begin(NOMBRE_BT);

  Serial.println("==============================");
  Serial.println(" ROBOT ESP32 - 4 RUEDAS");
  Serial.println(" MANUAL / AUTOMATICO / PID");
  Serial.print(" Bluetooth: ");
  Serial.println(NOMBRE_BT);
  Serial.println("==============================");

  Serial.println("1-5 = MOVIMIENTOS");
  Serial.println("8 = AUTOMATICO");
  Serial.println("9 = PID");
  Serial.println("10-100 = PWM");
}

// =====================================
// BUCLE PRINCIPAL
// =====================================
void loop() {

  // Bluetooth
  while (SerialBT.available()) {

    int b = SerialBT.read();

    procesarByte(b);
  }

  // USB
  if (Serial.available()) {

    String comando = Serial.readStringUntil('\n');

    procesarComando(comando);
  }

  // Seguridad Bluetooth
  static bool eraConectado = false;

  bool conectado = SerialBT.hasClient();

  if (eraConectado && !conectado) {

    detener();

    modoActual = MODO_MANUAL;

    reiniciarControl();

    Serial.println("BLUETOOTH DESCONECTADO: MOTORES DETENIDOS");
  }

  eraConectado = conectado;

  // Ejecutar algoritmo correspondiente
  if (modoActual == MODO_AUTOMATICO) {
    ejecutarAutomatico();
  }
  else if (modoActual == MODO_PID) {
    ejecutarPID();
  }

  // Aplicar objetivos a los motores
  actualizarRampa();
}
